var values = [1, 2]

values.extend([3])
values.concat(values)
assert_eq(values, [1, 2, 3, 1, 2, 3])
assert_eq(values.first(), 1)
assert_eq(values.last(), 3)
assert_eq(values.get(-1), 3)
assert_eq(values.get(-100), nothing)
assert_eq(values.slice(3, 1), [])
assert_eq([[1], [2, 3], 4].flatten(), [1, 2, 3, 4])
assert_eq(" , ".join(["one", "two"]), "one , two")
assert_eq("hello".capitalize(), "Hello")

use std.string as text

assert_eq("é".padStart(-1), "é")
assert_eq("é".padEnd(-1), "é")
assert_eq("é".repeat(-1), "")
assert_eq(text.padStart("é", -1), "é")
assert_eq(text.padEnd("é", -1), "é")
assert_eq(text.repeat("é", -1), "")
print("pure receivers passed")

# Receiver methods count Unicode scalar values, as std.string does.
use std.string as strings
var text = "é🙂aé🙂z"
assert_eq(text.len(), 6)
assert_eq(text.indexOf("a"), 2)
assert_eq(text.lastIndexOf("🙂"), 4)
assert_eq(text.indexOf("missing"), -1)
assert_eq(text.lastIndexOf("missing"), -1)
assert_eq(text.indexOf(""), 0)
assert_eq(text.lastIndexOf(""), 6)
assert_eq(text.indexOf("z"), strings.indexOf(text, "z"))
assert_eq(text.lastIndexOf("é"), strings.lastIndexOf(text, "é"))
assert_eq(text.charAt(1), "🙂")
assert_eq(text.charAt(-1), "")
assert_eq(text.charAt(6), "")
assert_eq(text.charAt(9223372036854775807), "")
assert_eq("".charAt(0), "")
assert_eq(text.substring(1, 4), "🙂aé")
assert_eq(text.substr(1, 4), "🙂aé")
assert_eq(text.slice(1, 4), "🙂aé")
assert_eq(text.substring(4, 1), "")
assert_eq(text.substring(-3, 2), "é🙂")
assert_eq(text.substring(2, -1), "")
assert_eq(text.substring(-3, -1), "")
assert_eq(text.substring(100, 200), "")
assert_eq(text.substring(0, 100), text)
assert_eq(text.substring(3), "é🙂z")
assert_eq(text.substring(4, 1), strings.slice(text, 4, 1))
assert_eq(text.substring(-3, 2), strings.slice(text, -3, 2))
print("string receivers ok")

# Receiver conversion aliases share metadata and runtime contracts on every backend.
assert_eq("42".toInt(), 42)
assert_eq(" 42 ".to_int(), 42)
assert_eq("42".parseInt(), 42)
assert_eq("42".parse_int(), 42)
assert_eq("1.5".toFloat(), 1.5)
assert_eq(" 1.5 ".to_float(), 1.5)
assert_eq("1.5".parseFloat(), 1.5)
assert_eq("1.5".parse_float(), 1.5)
assert_eq(" YES ".toBool(), true)
assert_eq("false".to_bool(), false)
assert_eq("1".toBool(), true)
assert_eq("no".to_bool(), false)
assert_eq("λ中".toString(), "λ中")
assert_eq("λ中".to_string(), "λ中")

var integerValue = 42
var floatValue = 2.5

assert_eq(integerValue.toFloat(), 42.0)
assert_eq(integerValue.to_float(), 42.0)
assert_eq(type(integerValue.toFloat()), "float")
assert_eq(integerValue.toString(), "42")
assert_eq(integerValue.to_string(), "42")
assert_eq(floatValue.toInt(), 2)
assert_eq(floatValue.to_int(), 2)
assert_eq(type(floatValue.toInt()), "integer")
assert_eq(floatValue.toString(), "2.5")
assert_eq(floatValue.to_string(), "2.5")

action convertInt with (certain value oftype dynamic) returns dynamic {
    return value.to_int()
}

action convertFloat with (certain value oftype dynamic) returns dynamic {
    return value.toFloat()
}

action convertBool with (certain value oftype dynamic) returns dynamic {
    return value.toBool()
}

action convertString with (certain value oftype dynamic) returns dynamic {
    return value.to_string()
}

var callbacks oftype list oftype dynamic = [convertInt, convertFloat, convertBool, convertString]

assert_eq(callbacks[0](" 7 "), 7)
assert_eq(callbacks[0](-2.5), -2)
assert_eq(callbacks[1](7), 7.0)
assert_eq(callbacks[1]("2.5"), 2.5)
assert_eq(callbacks[2]("true"), true)
assert_eq(callbacks[3](7), "7")
for invalid in ["abc", "", "9223372036854775808"] {
    var caught = false

    attempt {
        callbacks[0](invalid)
    } catch error {
        assert(error.contains("R0001"))
        caught = true
    }

    assert_eq(caught, true)
}

var caughtFloat = false

attempt {
    callbacks[1]("abc")
} catch error {
    assert(error.contains("R0001"))
    caughtFloat = true
}
assert_eq(caughtFloat, true)

var caughtDirectInt = false

attempt {
    "abc".toInt()
} catch error {
    assert(error.contains("R0001"))
    caughtDirectInt = true
}
assert_eq(caughtDirectInt, true)

var caughtDirectFloat = false

attempt {
    "abc".toFloat()
} catch error {
    assert(error.contains("R0001"))
    caughtDirectFloat = true
}
assert_eq(caughtDirectFloat, true)
print("receiver conversions passed")

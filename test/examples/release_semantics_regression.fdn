# Shared optimized interpreter/native contract for the implemented language surface.
use std.test as assertions
use std.math

action power with (certain base oftype integer, certain exponent oftype integer) returns flexible {
    return base ** exponent
}
action add with (certain x oftype flexible, certain y oftype flexible) returns flexible { return x + y }
action suffix with (certain x oftype flexible) returns flexible { return x + 0.5 }
action sub with (certain x oftype flexible, certain y oftype flexible) returns flexible { return x - y }
action mul with (certain x oftype flexible, certain y oftype flexible) returns flexible { return x * y }
action divideValues with (certain x oftype flexible, certain y oftype flexible) returns flexible { return x / y }
action rem with (certain x oftype flexible, certain y oftype flexible) returns flexible { return x % y }
action powerDynamic with (certain x oftype flexible, certain y oftype flexible) returns flexible { return x ** y }
action both with (certain x oftype flexible, certain y oftype flexible) { return x and y }
action either with (certain x oftype flexible, certain y oftype flexible) { return x or y }
action negate with (certain x oftype flexible) { return -x }
action positive with (certain x oftype flexible) returns flexible { return +x }
action invert with (certain x oftype flexible) { return not x }
action less with (certain x oftype flexible, certain y oftype flexible) { return x < y }
action equal with (certain x oftype flexible, certain y oftype flexible) { return x == y }
action different with (certain x oftype flexible, certain y oftype flexible) { return x != y }
action expectTypeError with (certain callback oftype action) {
    var caught = false
    attempt { callback() } catch error {
        assert(error.contains("type error"))
        assert(error.contains("R0001"))
        caught = true
    }
    assert_eq(caught, true)
}
action get with (certain target oftype flexible, certain index oftype flexible) { return target[index] }
action assignIndex with (certain target oftype flexible, certain index oftype flexible, certain value oftype flexible) { target[index] = value }
# Multiple blocks keep these as actual direct calls through the optimizer.
action identity with (certain value oftype flexible) returns flexible {
    if type(value) == "nothing" { return value }
    return value
}
action zero { return 1 }
action two with (certain first oftype integer, certain second oftype integer) { return first + second }
action defaulted with (certain value oftype integer, optional delta oftype integer = 2) { return value + delta }
action optionalValue with (optional value oftype flexible) returns flexible { return value }
action hidden with (certain callback oftype flexible) returns flexible {
    if type(callback) == "nothing" { return callback }
    return callback
}

assert_eq(2 ** -3, 0.125)
assertions.assert_eq(10 ** -2, 0.01)
assert_eq(1 ** -999, 1)
assert_eq((-1) ** -3, -1)
assert_eq((-1) ** -4, 1)
const var reciprocal = 2 ** -3
assert_eq(reciprocal, 0.125)
for base in [2, -2, 1, -1] {
    for exponent in [-3, -4, 3, 4] {
        assertions.assert_eq(power(base, exponent), powerDynamic(base, exponent))
    }
}
assert_eq(type(power(2, -3)), "float")
assert_eq(type(power(2, 3)), "integer")
assert_eq(type(power(-1, -3)), "integer")
var caught = false
attempt { power(0, -1) } catch error { assert(error.contains("R2001")); caught = true }
assert_eq(caught, true)
caught = false
attempt { power(2, 63) } catch error { assert(error.contains("R2003")); caught = true }
assert_eq(caught, true)

assert_eq(add("text", 3), "text3")
assert_eq(suffix("text"), "text0.5")
assert_eq(type(suffix("text")), "string")
assert_eq(suffix(2), 2.5)
assert_eq(add(true, "text"), "truetext")
assert_eq("text" + nothing, "textnothing")
assert_eq(both(true, false), false)
assert_eq(either(false, true), true)
assert_eq(invert(true), false)
assert_eq(less(9007199254740992, 9007199254740993), true)
expectTypeError(action { return sub("text", 1) })
expectTypeError(action { return mul("text", 0) })
expectTypeError(action { return divideValues("text", 1) })
expectTypeError(action { return rem("text", 1) })
expectTypeError(action { return powerDynamic("text", 1) })
expectTypeError(action { return both(1, true) })
expectTypeError(action { return either(false, "text") })
expectTypeError(action { return invert(1) })
expectTypeError(action { return negate("text") })
expectTypeError(action { return less(true, false) })

var list = [10, 20]
assert_eq(get(list, -1), 20)
assignIndex(list, -1, 21)
assert_eq(get(list, 1), 21)
assert_eq(get("aλ中", -1), "中")
expectTypeError(action { return get(1, 0) })
expectTypeError(action { return get(list, "bad") })
expectTypeError(action { assignIndex(list, "bad", 99); return nothing })
expectTypeError(action { assignIndex(1, 0, 99); return nothing })
caught = false
attempt { get(list, -3) } catch error { assert(error.contains("R2002")); caught = true }
assert_eq(caught, true)
var dictionary = { "answer": 42 }
assert_eq(get(dictionary, "missing"), nothing)
assignIndex(dictionary, "answer", 43)
assert_eq(get(dictionary, "answer"), 43)
assert_eq(get(dictionary, [1]), nothing)
assignIndex(dictionary, [1], 99)
assert_eq(get(dictionary, [1]), 99)

assertions.assert_eq([1.0, (2.0, { "value": 3.0 })], [1.0 + 0.0000000000005, (2.0 + 0.0000000000005, { "value": 3.0 + 0.0000000000005 })])
assert_eq([1.0].contains(1.0 + 0.0000000000005), false)
assert_eq([[1, 2]].contains([1, 2]), true)
assert_eq([(1, "x")].find((1, "x")), 0)
assert_eq([{ "value": [1, 2] }].contains({ "value": [1, 2] }), true)

var dynamicCounter oftype flexible = Shared(0)
for callback in [zero, two] {
    caught = false
    attempt { dynamicCounter.update(callback) } catch error { assert(error.contains("argument")); caught = true }
    assert_eq(caught, true)
    assert_eq(dynamicCounter.get(), 0)
}
caught = false
attempt { dynamicCounter.update(hidden(1)) } catch error { assert(error.contains("R0001")); caught = true }
assert_eq(caught, true)
assert_eq(dynamicCounter.get(), 0)
assert_eq(dynamicCounter.update(defaulted), 2)
var dynamicDefault = hidden(defaulted)
assert_eq(dynamicDefault(1, nothing), 3)
var dynamicOptional = hidden(optionalValue)
assert_eq(dynamicOptional(), nothing)
assert_eq(dynamicOptional(nothing), nothing)

var typedCounter = Shared(0)
var incompatible = hidden(action with (certain value oftype flexible) returns flexible { return "wrong" })
caught = false
attempt { typedCounter.update(incompatible) } catch error { assert(error.contains("R0001")); caught = true }
assert_eq(caught, true)
assert_eq(typedCounter.get(), 0)
var incompatibleParam = hidden(action with (certain value oftype string) { return 1 })
caught = false
attempt { typedCounter.update(incompatibleParam) } catch error { assert(error.contains("R0001")); caught = true }
assert_eq(caught, true)
assert_eq(typedCounter.get(), 0)
assert_eq(typedCounter.update(math.abs), 0)
var capturedValue = 4
var capturedAction = action with (certain value oftype integer) { return value + capturedValue }
assert_eq(typedCounter.update(capturedAction), 4)
assertions.assert_eq(identity(capturedAction)(1), 5)

var dynamicIdentity = hidden(identity)
var dynamicPositive = hidden(positive)
for repetition in 0..100 {
    for value in ["owned", [1, 2], (1, "x"), { "key": [3, 4] }, identity] {
        assertions.assert_eq(identity(value), value)
        assertions.assert_eq(dynamicIdentity(value), value)
        assertions.assert_eq(dynamicPositive(value), value)
    }
}
enum Choice { First, Second }
object FirstClass { var value = 0 }
object SecondClass { var value = 0 }
assert_eq(equal(Choice.First, Choice), false)
assert_eq(different(Choice, Choice.First), true)
assert_eq(equal(FirstClass, FirstClass), true)
assert_eq(different(FirstClass, SecondClass), true)
assert_eq([Choice.First].contains(Choice.First), true)
assert_eq([Choice.First].find(Choice.Second), -1)
assert_eq(["hello"].contains("hello"), true)
const var largeOrder = 9007199254740992 < 9007199254740993
assert_eq(largeOrder, true)
action constAddOverflow { const var value = 9223372036854775807 + 1; return value }
action constSubOverflow { const var value = (-9223372036854775807 - 1) - 1; return value }
action constMulOverflow { const var value = 9223372036854775807 * 2; return value }
action constNegOverflow { const var value = -(-9223372036854775807 - 1); return value }
action constDivOverflow { const var value = (-9223372036854775807 - 1) / -1; return value }
action constRemOverflow { const var value = (-9223372036854775807 - 1) % -1; return value }
for callback in [constAddOverflow, constSubOverflow, constMulOverflow, constNegOverflow, constDivOverflow, constRemOverflow] {
    caught = false
    attempt { callback() } catch error { assert(error.contains("R2003")); caught = true }
    assert_eq(caught, true)
}
print("release semantics ok")

# Shared semantic fixture: interpreter, JIT fallback, and native backends.
use std.string as strings
action verify_slicing {
    var text = "somestring"
    assert_eq(text[1:4], "ome")
    assert_eq(text[:4], "some")
    assert_eq(text[3:], "estring")
    assert_eq(text[:], text)
    assert_eq(text[::], text)
    assert_eq(text[nothing:nothing:nothing], text)
    assert_eq(text[1:4:], "ome")
    assert_eq(text[::2], "smsrn")
    assert_eq(text[1:7:2], "oet")
    assert_eq(text[1::2], "oetig")
    assert_eq(text[::-1], "gnirtsemos")
    assert_eq(text[-3:], "ing")
    assert_eq(text[:-2], "somestri")
    assert_eq(text[7:1:-2], "ite")
    assert_eq(text[100::-1], "gnirtsemos")
    assert_eq(text[-100::-1], "")
    assert_eq(text[:-100:-1], "gnirtsemos")
    assert_eq(text[:-1:-1], "")
    assert_eq(text[4:1], "")
    assert_eq(text[1:4:-1], "")
    assert_eq(text[100:200], "")
    assert_eq(text[-100:100], text)
    assert_eq(""[::-1], "")
    assert_eq("aé🌱中z"[1:4:2], "é中")
    assert_eq("aé🌱中z"[::-1], "z中🌱éa")
    assert_eq(text[1..4], "ome")
    assert_eq(text[1...4], "omes")
    assert_eq(text[7...1 step -2], "iteo")
    assert_eq(text[.. step -1], "gnirtsemos")
    assert_eq(text[0:9:9223372036854775807], "s")
    assert_eq(text[9:0:(-9223372036854775807 - 1)], "g")
    assert_eq(text[1], "o")
    assert_eq(text[-1], "g")
    assert_eq("aé🌱中z"[2], "🌱")
    assert_eq(len("aé🌱中z"), 5)
    assert_eq("aé🌱中z".len(), 5)
    assert_eq(strings.len("aé🌱中z"), 5)
    assert_eq([nothing][0], nothing)
    var wide_range = (-9223372036854775807 - 1)...9223372036854775807
    assert_eq(wide_range[0], -9223372036854775807 - 1)
    assert_eq(wide_range[-1], 9223372036854775807)
    assert_eq(wide_range[:1], [-9223372036854775807 - 1])
    assert_eq(text[[1, 2][0]:4], "ome")
    assert_eq([1, 2, 3, 4, 5][::2], [1, 3, 5])
    assert_eq([1, 2, 3, 4, 5][::-1], [5, 4, 3, 2, 1])
    assert_eq((1..6)[1:5:2], [2, 4])
    assert_eq((1...5)[::-1], [5, 4, 3, 2, 1])
    assert_eq((5..1)[::-1], [])
    assert_eq((1..5).contains(5), false)
    assert_eq((1...5).contains(5), true)
    assert_eq((1..5).contains(2), true)
    assert_eq((1..5).contains(0), false)
    assert_eq((9223372036854775806...9223372036854775807)[:], [9223372036854775806, 9223372036854775807])
    print("slicing ok")
}
verify_slicing()
